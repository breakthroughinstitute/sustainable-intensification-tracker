# Only the finished tracker and deployment recipe belong in the Git repository.
# Research, local Netlify state, archives, previews, and working files stay local.
/*
!/.gitignore
!/netlify.toml
!/build.sh
!/preview.command
!/edit_server.py
!/README.md
!/NETLIFY.md
!/index.html
!/app.js
!/styles.css
!/data.json
!/biotech-decisions.json
!/biotech-records.csv
!/biotech-epa-events.csv
!/product-studies.json
!/text-edits.json
!/assets/
/assets/*
!/assets/bti-logo.png

!/EMBED.md
!/DESIGN-REVIEW.md
!/embed-example.html

!/rd-federal-spending.csv
!/rd-source-comparison.csv
!/rd-gateway-annual-totals.csv

!/fda-consultations.csv
!/fda-consultations-annual.csv

!/fda-premarket-meetings.csv

!/rd-reported-support-comparison.csv
!/livestock-productivity.csv

!/rd-spending-public-series.csv

!/rd-performer-components.csv

!/rd-funding-components.csv

!/rd-herd-all-sources.csv

!/rd-updated-sources.json

!/rd-performer-history.csv

!/rd-funding-totals.csv

!/rd-performer-usda-detail.csv

!/rd-spending-methods.txt

!/rd-funding-drilldowns.csv

!/rd-updated-methods.txt

